<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>pianoroll</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Product>Piano Roll</Product>
    <!-- Optimise even Debug builds. Audio has a hard deadline: every 23ms block must be ready in
         time or it plays as a gap (a pop), and unoptimised DSP loops miss it. -->
    <Optimize>true</Optimize>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shown in Help > About. -->
    <AssemblyMetadata Include="BuildDate" Value="$([System.DateTime]::UtcNow.ToString('o'))" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="resources\**" />
    <!-- The app icon, shown in the window, the taskbar and Help > About. -->
    <AvaloniaResource Include="images\icon.png" />
    <!-- The picture F1 puts behind the notes, for recording. -->
    <AvaloniaResource Include="images\wallpaper.jpg" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Melanchall.DryWetMidi" Version="8.0.3" />
    <PackageReference Include="MeltySynth" Version="2.4.1" />
    <PackageReference Include="ppy.SDL2-CS" Version="1.0.741-alpha" />
  </ItemGroup>

</Project>
