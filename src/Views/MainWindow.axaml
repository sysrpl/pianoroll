<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="using:pianoroll.Helpers"
        xmlns:c="using:pianoroll.Controls"
        x:Class="pianoroll.Views.MainWindow"
        Title="Piano Roll"
        Icon="/images/icon.png"
        Width="1000" Height="700"
        MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- A smaller, round slider thumb, and a slider no taller than the toolbar's buttons.
             Avalonia's Fluent Slider reads all four of these with DynamicResource. -->
        <x:Double x:Key="SliderHorizontalThumbWidth">12</x:Double>
        <x:Double x:Key="SliderHorizontalThumbHeight">12</x:Double>
        <CornerRadius x:Key="SliderThumbCornerRadius">6</CornerRadius>
        <x:Double x:Key="SliderHorizontalHeight">24</x:Double>
    </Window.Resources>

    <Window.Styles>
        <!-- The toolbar: every control on one centre line, and every button the same 24px
             height, so nothing sits a pixel off its neighbours. -->
        <Style Selector=":is(Panel).toolbar > :is(Control)">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector=":is(Panel).toolbar > Button, :is(Panel).toolbar > ToggleButton">
            <Setter Property="Height" Value="24" />
            <Setter Property="MinHeight" Value="0" />
        </Style>

        <!-- Icon-only buttons: flat and 24x24, like toolbar buttons. -->
        <Style Selector="Button.icon">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Button.icon TextBlock.icon">
            <Setter Property="FontSize" Value="18" />
        </Style>
        <!-- Icon-only toggles: 24x24 like the buttons, lit with the accent while on. -->
        <Style Selector="ToggleButton.icon">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ToggleButton.icon TextBlock.icon">
            <Setter Property="FontFamily" Value="{StaticResource MaterialDesignIcons}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- The roll and the keyboard sit on the same dark strip, so the bars appear to land on the keys. -->
        <Style Selector="Border.stage">
            <Setter Property="Background" Value="#1A1A1A" />
        </Style>
        <Style Selector="Border#KeyboardArea">
            <Setter Property="BorderBrush" Value="{DynamicResource MintBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <!-- Toolbar: one row, or two while the keyboard is split. -->
        <StackPanel DockPanel.Dock="Top">
        <DockPanel Classes="toolbar" Margin="8,0,8,0" LastChildFill="False">
            <Button x:Name="OpenButton" DockPanel.Dock="Left" Click="OpenMidi_Click" Margin="0,0,8,0"
                    h:Tip.Title="Open MIDI file (Ctrl+O)"
                    h:Tip.Text="Choose a .mid file to watch and play.">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="icon" Text="{x:Static h:Icons.FolderOpen}" />
                    <TextBlock Classes="label" Text="Open..." />
                </StackPanel>
            </Button>

            <Button x:Name="PlayButton" Classes="icon" DockPanel.Dock="Left" Click="Play_Click"
                    h:Tip.Title="Play" h:Tip.Text="Start the song from where the playhead is.">
                <TextBlock Classes="icon" Text="{x:Static h:Icons.Play}" />
            </Button>
            <Button x:Name="PauseButton" Classes="icon" DockPanel.Dock="Left" Click="Pause_Click" Margin="4,0,0,0"
                    h:Tip.Title="Pause" h:Tip.Text="Stop where it is; playing again carries on from here.">
                <TextBlock Classes="icon" Text="{x:Static h:Icons.Pause}" />
            </Button>
            <Button x:Name="StopButton" Classes="icon" DockPanel.Dock="Left" Click="Stop_Click" Margin="4,0,0,0"
                    h:Tip.Title="Stop" h:Tip.Text="Stop and rewind to the beginning.">
                <TextBlock Classes="icon" Text="{x:Static h:Icons.Stop}" />
            </Button>

            <Button x:Name="InstrumentButton" DockPanel.Dock="Left" Click="Instrument_Click" Margin="12,0,0,0"
                    h:Tip.Title="Instrument"
                    h:Tip.Text="Choose what the keys sound like: piano, organ, electric guitar or banjo.">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="icon" Text="{x:Static h:Icons.Piano}" />
                    <TextBlock x:Name="InstrumentText" Classes="label" Text="Piano" />
                </StackPanel>
            </Button>

            <ToggleButton x:Name="SplitToggle" Classes="icon" DockPanel.Dock="Left" Margin="8,0,0,0"
                          IsCheckedChanged="SplitToggle_Changed"
                          h:Tip.Title="Keyboard split"
                          h:Tip.Text="Play the song with two instruments: one for the keys left of the red line, one for the keys right of it. Drag the line in the roll to move the split.">
                <TextBlock Classes="icon" Text="{x:Static h:Icons.ArrowSplitVertical}" />
            </ToggleButton>
            <ToggleButton x:Name="SplitControlsToggle" Classes="icon" DockPanel.Dock="Left" Margin="4,0,0,0"
                          IsEnabled="False" IsCheckedChanged="SplitControls_Changed"
                          h:Tip.Title="Show split controls"
                          h:Tip.Text="Show or hide the split's instrument and gain row and its red line. The split keeps playing either way, so it can be hidden for a clean view.">
                <TextBlock Classes="icon" Text="{x:Static h:Icons.TuneVertical}" />
            </ToggleButton>

            <Button x:Name="FullScreenButton" Classes="icon" DockPanel.Dock="Right" Click="FullScreen_Click"
                    Margin="4,0,0,0"
                    h:Tip.Title="Full screen (F11)"
                    h:Tip.Text="Fill the screen with the keyboard and the falling notes.">
                <TextBlock x:Name="FullScreenIcon" Classes="icon" Text="{x:Static h:Icons.Fullscreen}" />
            </Button>

            <Button Classes="icon" DockPanel.Dock="Right" Click="About_Click"
                    h:Tip.Title="About Piano Roll"
                    h:Tip.Text="Version, what the program does, and build information.">
                <TextBlock Classes="icon" Text="{x:Static h:Icons.HelpCircleOutline}" />
            </Button>

            <!-- Volume, at the right-hand end of the toolbar. -->
            <Slider x:Name="VolumeSlider" DockPanel.Dock="Right" Width="110" Minimum="0" Maximum="1"
                    VerticalAlignment="Center" Margin="8,0,8,0"
                    h:Tip.Title="Volume" h:Tip.Text="How loud the keyboard plays." />
            <!-- Sized and centred exactly like an icon button's glyph, so it lines up with them. -->
            <Border DockPanel.Dock="Right" Width="24" Height="24">
                <TextBlock FontFamily="{StaticResource MaterialDesignIcons}" FontSize="18"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Text="{x:Static h:Icons.VolumeHigh}" />
            </Border>

            <TextBlock x:Name="TimeText" DockPanel.Dock="Right" Classes="dim" VerticalAlignment="Center"
                       Margin="12,0,12,0" Text="0:00 / 0:00" />

        </DockPanel>

        <!-- The split's two halves: the left voice 8px from the left edge, the right voice
             8px past the middle, each with its instrument and a gain to lift or lower it. -->
        <Grid x:Name="SplitBar" ColumnDefinitions="*,*" IsVisible="False">
            <StackPanel Grid.Column="0" Classes="toolbar" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
                <TextBlock Text="Left" Classes="dim" VerticalAlignment="Center" />
                <Button x:Name="LeftInstrumentButton" Click="LeftInstrument_Click"
                        h:Tip.Title="Left instrument"
                        h:Tip.Text="What the keys left of the red line play.">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Classes="icon" Text="{x:Static h:Icons.Piano}" />
                        <TextBlock x:Name="LeftInstrumentText" Classes="label" Text="Real bass" />
                    </StackPanel>
                </Button>
                <Slider x:Name="LeftGainSlider" Width="120" Minimum="-12" Maximum="12" Value="0"
                        TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                        h:Tip.Title="Left gain" h:Tip.Text="Make the left instrument louder or quieter." />
                <TextBlock x:Name="LeftGainText" Classes="dim" VerticalAlignment="Center" Width="48" Text="0 dB" />
            </StackPanel>

            <StackPanel Grid.Column="1" Classes="toolbar" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
                <TextBlock Text="Right" Classes="dim" VerticalAlignment="Center" />
                <Button x:Name="RightInstrumentButton" Click="Instrument_Click"
                        h:Tip.Title="Right instrument"
                        h:Tip.Text="What the keys right of the red line play.">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Classes="icon" Text="{x:Static h:Icons.Piano}" />
                        <TextBlock x:Name="RightInstrumentText" Classes="label" Text="Piano" />
                    </StackPanel>
                </Button>
                <Slider x:Name="RightGainSlider" Width="120" Minimum="-12" Maximum="12" Value="0"
                        TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                        h:Tip.Title="Right gain" h:Tip.Text="Make the right instrument louder or quieter." />
                <TextBlock x:Name="RightGainText" Classes="dim" VerticalAlignment="Center" Width="48" Text="0 dB" />
            </StackPanel>
        </Grid>
        </StackPanel>

        <Grid ColumnDefinitions="*,Auto" RowDefinitions="*,Auto">
            <!-- The falling notes. -->
            <Border Grid.Row="0" Grid.Column="0" Classes="stage" Padding="8,8,8,0">
                <Grid>
                    <c:PianoRoll x:Name="Roll" LookAhead="4" />
                    <TextBlock x:Name="PlaceholderText" Classes="dim" TextWrapping="Wrap"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Text="Click the keys below to play them, or open a MIDI file to watch it play." />
                </Grid>
            </Border>

            <!-- The seek bar runs down the right of both the roll and the keyboard. -->
            <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Classes="stage" Padding="4,8">
                <c:SeekBar x:Name="Seek" />
            </Border>

            <!-- The keyboard along the bottom. -->
            <!-- No fixed height: the keyboard asks for one that keeps the keys in proportion. -->
            <Border x:Name="KeyboardArea" Grid.Row="1" Grid.Column="0" Classes="stage"
                    Padding="8">
                <!-- A full-sized piano: A0 to C8. -->
                <c:PianoKeyboard x:Name="Keyboard" FirstNote="21" LastNote="108" />
            </Border>
        </Grid>
    </DockPanel>
</Window>
